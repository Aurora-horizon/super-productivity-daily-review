{
  "name": "每日复盘与计划",
  "id": "daily-review",
  "manifestVersion": 1,
  "version": "2.11.0",
  "minSupVersion": "19.1.0",
  "description": "Linear 风格每日复盘：支持任务系列、未来 7 天自动补齐、每个实例按计划日更新标题日期、历史同名任务类型同步、逾期一次性任务分流、无法完成原因记录、改期撤销和日结，修复大归档写入、勾选卡顿，支持插件内直接新建任务，并通过任务快照去重把容量目标降到约 150 KiB。",
  "author": "Aurora-horizon",
  "hooks": [
    "taskCreated",
    "taskUpdate",
    "taskComplete",
    "taskDelete",
    "anyTaskUpdate",
    "finishDay"
  ],
  "nodeScriptConfig": {
    "timeout": 10000,
    "memoryLimit": "128MB"
  },
  "permissions": [
    "getAppState",
    "getTasks",
    "getArchivedTasks",
    "getAllProjects",
    "getAllTags",
    "addTask",
    "updateTask",
    "persistDataSynced",
    "loadSyncedData",
    "selectTask",
    "showIndexHtmlAsView",
    "showSnack",
    "downloadFile",
    "nodeExecution"
  ],
  "iFrame": true,
  "sidePanel": false,
  "type": "standard",
  "assets": [],
  "icon": "icon.svg"
}



